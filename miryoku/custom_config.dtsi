#define U_TAPPING_TERM 190

/ {
  behaviors {
    u_lt_sym_hp: u_lt_sym_hp {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      tapping-term-ms = <U_TAPPING_TERM>;
      flavor = "hold-preferred";
      bindings = <&mo>, <&kp>;
    };
  };

  // Hold A+S+D+F → BT layer (36-key Miryoku positions).
  // Corne-like boards with unused outer columns: use <13 14 15 16>.
  combos {
    compatible = "zmk,combos";
    combo_bt {
      timeout-ms = <50>;
      key-positions = <10 11 12 13>;
      bindings = <&mo U_MEDIA>;
      layers = <U_BASE>;
    };
  };
};
